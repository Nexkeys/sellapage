{
  "version": 2,
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...route]"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "sellapage.com.ng"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.sellapage.com.ng"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/api/storefront-render?route=storefront-render"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/live-stores",
      "destination": "/live-stores/index.html"
    },
    {
      "source": "/success-stories",
      "destination": "/success-stories/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/report-store",
      "destination": "/report-store/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/jobs",
      "destination": "/jobs/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/tools/offer-name-lab",
      "destination": "/tools/offer-name-lab/index.html"
    },
    {
      "source": "/tools/policy-generator",
      "destination": "/tools/policy-generator/index.html"
    },
    {
      "source": "/compare/vs-shopify",
      "destination": "/compare/vs-shopify/index.html"
    },
    {
      "source": "/compare/vs-linktree",
      "destination": "/compare/vs-linktree/index.html"
    },
    {
      "source": "/compare/vs-whatsapp-business",
      "destination": "/compare/vs-whatsapp-business/index.html"
    },
    {
      "source": "/compare/vs-instagram-bio",
      "destination": "/compare/vs-instagram-bio/index.html"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]{1,60})/feed.xml",
      "destination": "/api/product-feed?route=product-feed&slug=:slug"
    },
    {
      "source": "/:slug((?!about$|account-recovery$|admin$|billing$|compare$|contact$|dashboard$|jobs$|join-team$|live-stores$|login$|pricing$|privacy-policy$|register$|report-store$|reset-password$|review$|success-stories$|terms$|tools$)[a-z0-9][a-z0-9-]{1,60})/services",
      "destination": "/api/storefront-render?route=storefront-render&slug=:slug"
    },
    {
      "source": "/:slug((?!about$|account-recovery$|admin$|billing$|compare$|contact$|dashboard$|jobs$|join-team$|live-stores$|login$|pricing$|privacy-policy$|register$|report-store$|reset-password$|review$|success-stories$|terms$|tools$)[a-z0-9][a-z0-9-]{1,60})",
      "destination": "/api/storefront-render?route=storefront-render&slug=:slug"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...route].js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}

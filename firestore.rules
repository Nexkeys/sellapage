rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /stores/{storeId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == storeId;
      allow update: if request.auth != null && request.auth.uid == storeId;
      allow delete: if request.auth != null && request.auth.uid == storeId;
      
      // Products & variations configuration
      match /products/{productId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == storeId;
        
        // Batch A: Product reviews subcollection
        match /reviews/{reviewId} {
          allow read: if true; 
          allow write: if false; 
        }

        // Protective: If variation matrices are ever stored as subdocuments
        match /variations/{variantId} {
          allow read: if true;
          allow write: if request.auth != null && request.auth.uid == storeId;
        }
      }
      
      // Protective: Allows standalone store category structures if queried separately
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == storeId;
      }
      
      match /services/{serviceId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == storeId;
        
        match /reviews/{reviewId} {
          allow read: if true; 
          allow write: if false; 
        }
      }
      
      match /orders/{orderId} {
        allow read, write: if request.auth != null && request.auth.uid == storeId;
      }
      
      match /analytics/{docId} {
        allow read: if request.auth != null && request.auth.uid == storeId;
        allow write: if true;
      }
      
      match /subscriptions/{subId} {
        allow read: if request.auth != null && request.auth.uid == storeId;
        allow write: if false;
      }

      match /discounts/{discountId} {
        allow read, write: if request.auth != null && request.auth.uid == storeId;
      }

      match /customers/{customerId} {
        allow read, write: if request.auth != null && request.auth.uid == storeId;
      }

      // Dynamic Manual Orders Ledger Sync Subcollection
      match /ledger/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == storeId;
      }
    }
    
    match /leads/{leadId} {
      allow create: if true;
      allow read: if request.auth != null;
    }
    
    match /waitlist/{id} {
      allow create: if true;
      allow read: if request.auth != null;
    }
    
    match /supportEnquiries/{enquiryId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == resource.data.storeId;
    }
    
    match /supportMessages/{messageId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == resource.data.storeId;
    }
  }
}
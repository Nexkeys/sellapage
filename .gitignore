# scripts/ is ignored (one-off migrations, output that may contain customer PII),
# BUT build-critical guards must ship or the Vercel build dies with
# MODULE_NOT_FOUND - which is exactly what happened when check-ai-models.js was
# added and never committed. `scripts/*` (not `scripts`) is required: git cannot
# re-include a file whose PARENT DIRECTORY is excluded, so the bare `scripts`
# rule made the negations below impossible.
scripts/*
!scripts/check-*.js
!scripts/prerender-seo.mjs


# Local Vercel folder
.aider*
.vercel
.env*
.claude

# Migration script output (may contain customer PII)
scripts/migration-output

src/api-handlers/_generated/

# Original photos and videos dropped in for the website. They stay on this
# computer: phone videos are tens of megabytes and do not belong in git. Only
# the compressed copies in public/media/ and src/media/media-manifest.json are
# committed. The README is kept so the folder explains itself on a new machine.
media-src/*
!media-src/README.md
